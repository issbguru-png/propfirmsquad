{
  "name": "web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed.ts",
    "import:firms": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/import-firms.ts",
    "export:firms": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/export-firms.ts",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "test:e2e": "payload run scripts/ensure-admin.ts && playwright test"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/next": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "@propfirmsquad/calc": "workspace:*",
    "cross-env": "^7.0.3",
    "graphql": "^16.9.0",
    "next": "^15.4.0",
    "payload": "^3.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
