# Copy to apps/web/.env for local work. In production these are set in the
# hosting dashboard, never committed.

# Postgres connection string.
#   local:      postgres://localhost:5432/propfirmsquad
#   production: the pooled connection string from Neon or Supabase.
# Payload opens a connection per request, so a serverless host MUST use the
# POOLED url, not the direct one, or the database will refuse connections
# under any real traffic.
DATABASE_URI=postgres://localhost:5432/propfirmsquad

# Signs admin session cookies. Any long random string.
# Generate one with:  openssl rand -base64 32
# Changing it logs every admin user out. Never reuse the local value in prod.
PAYLOAD_SECRET=change-me-locally-only

# Absolute public origin, no trailing slash. Canonical URLs, Open Graph tags,
# sitemap entries and JSON-LD @ids are all built from this, so a wrong value
# silently publishes wrong canonicals to Google.
#   local:      http://localhost:3000
#   production: https://propfirmsquad.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Playwright only. Not needed in production.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
